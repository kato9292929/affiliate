---
import { SITE } from '../../site.config';
---
<footer class="site-footer">
  <div class="container">
    <nav aria-label="サイト情報">
      <ul>
        <li><a href="/about/">運営者情報</a></li>
        <li><a href="/supervisors/">監修者</a></li>
        <li><a href="/ad-policy/">広告掲載ポリシー</a></li>
        <li><a href="/privacy/">プライバシーポリシー</a></li>
        <li><a href="/corrections/">訂正の方針</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
    <p class="operator">
      運営会社：<a href={SITE.publisher.url} rel="noopener">{SITE.publisher.name}</a>
      （公式サイト：<a href={SITE.publisher.url} rel="noopener">{SITE.publisher.url.replace(/^https?:\/\//, '')}</a>）
    </p>
    <p class="copy">© {new Date().getFullYear()} {SITE.publisher.name}</p>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--color-border); background: var(--color-surface); padding: var(--space-6) 0; font-size: var(--font-size-sm); }
  ul { list-style: none; padding: 0; margin: 0 0 var(--space-4); display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  a, a:visited { color: var(--color-text); }
  .copy { color: var(--color-text-muted); margin: 0; }
</style>
