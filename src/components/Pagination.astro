---
interface Props { current: number; last: number; base: string }
const { current, last, base } = Astro.props;
const href = (n: number) => (n === 1 ? base : `${base}page/${n}/`);
---
{last > 1 && (
  <nav class="pagination" aria-label="ページ送り">
    {current > 1 && <a href={href(current - 1)} rel="prev">前へ</a>}
    <span aria-current="page">{current} / {last}</span>
    {current < last && <a href={href(current + 1)} rel="next">次へ</a>}
  </nav>
)}
