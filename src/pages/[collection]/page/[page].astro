---
import ListPage from '../../../components/ListPage.astro';
import { collectionPaths, COLLECTION_LABELS, type ArticleCollection, type ListProps } from '../../../lib/list-paths';
export const getStaticPaths = () => collectionPaths(false);
const col = Astro.params.collection as ArticleCollection;
const p = Astro.props as ListProps;
---
<ListPage title={COLLECTION_LABELS[col]} description={`${COLLECTION_LABELS[col]}の記事一覧。`}
  crumbs={[{ label: COLLECTION_LABELS[col], href: `/${col}/` }, { label: `${p.current}ページ目` }]}
  {...p} base={`/${col}/`} contentGroup={col} />
